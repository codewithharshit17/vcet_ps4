# Copy to `.env` and fill in. This is the ONLY manual setup step.
#
# Get a free key (no credit card) at https://console.groq.com/keys
GROQ_API_KEY=

# --- everything below is optional; defaults work out of the box ---

# SEC EDGAR requires a real contact string in the User-Agent or it returns 403.
# Format: "Name email@domain.com"
SEC_USER_AGENT=Token-Diet Research contact@example.com

# Leave unset to run Qdrant embedded (no Docker needed).
# Set to http://localhost:6333 to use the docker-compose Qdrant service.
# TOKENDIET_QDRANT_URL=http://localhost:6333

# Leave unset to use the local on-disk cache fallback (no Docker needed).
# Set to redis://localhost:6379/0 to use the docker-compose Redis service.
# TOKENDIET_REDIS_URL=redis://localhost:6379/0
